{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fotisp-astral",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",

  "kv_namespaces": [
    { "binding": "SESSION", "id": "REPLACE_WITH_SESSION_KV_ID", "preview_id": "REPLACE_WITH_SESSION_PREVIEW_KV_ID" },
    { "binding": "CONTACT", "id": "REPLACE_WITH_CONTACT_KV_ID", "preview_id": "REPLACE_WITH_CONTACT_PREVIEW_KV_ID" }
  ],

  // Provision D1/R2 in the Cloudflare Dashboard or uncomment once resources are created:
  /*
  "d1_databases": [
    { "binding": "DB", "database_name": "fotisp-astral-db", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "fotisp-astral-media" }
  ],
  */

  "vars": {
    "SITE_URL": "https://fotisp.gr",
    "THEME_VARIATION": "convert"
  }
}
